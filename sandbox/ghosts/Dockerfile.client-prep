# #3597: ghosts-client-test's build, minus the CA-bundle step.
#
# Upstream's Dockerfile-client-universal opens with `COPY certs/*.crt ...` and
# expects the operator to drop a CA certificate into certs/. The vendored tree
# ships only certs/readme.md (certificates are a forbidden artifact in this
# repository), so that glob matches nothing and buildkit fails with
# "lstat /certs: no such file or directory" -- the image could not be built
# anywhere, which swarm (no local builds, #3587) cannot live with. This
# wrapper builds the same stages from the same vendored sources without that
# step; the throwaway enrollment client talks plain HTTP to ghosts-api on
# ghosts_net, so it has no CA to trust. The vendored files stay byte-for-byte
# upstream (see vendor/ghosts-src/VENDORED.md). Build context is
# sandbox/ghosts, like Dockerfile.api-prep.
FROM mcr.microsoft.com/dotnet/sdk:10.0.403@sha256:de4fe90a98845d75910b9769662465c84de1a934665c431279d1382b2bddc02b AS dev

COPY vendor/ghosts-src/Ghosts.Client.Universal/. /app/Ghosts.Client.Universal
COPY vendor/ghosts-src/Ghosts.Domain/. /app/Ghosts.Domain

WORKDIR /app/Ghosts.Client.Universal
RUN dotnet publish -c Release -o /app/dist

FROM mcr.microsoft.com/dotnet/runtime:10.0
COPY --from=dev /app/dist /app
WORKDIR /app

LABEL "product"="GHOSTS Client Universal"
LABEL "maintainer"="Dustin Updyke <ddupdyke[-@-]sei.cmu.edu>"

CMD ["dotnet", "Ghosts.Client.Universal.dll"]
