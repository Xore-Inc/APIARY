[Unit]
Description=Belt-and-braces LAN-block iptables policy for the GHOSTS guest network (virbr-ghosts)
# docker.service creates DOCKER-USER, which apply() inserts into. Without this
# ordering the unit failed at boot once firewalld started first (#3742).
After=libvirtd.service virtqemud.socket network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/honeypot-ghosts/network-filter.sh apply
ExecStop=/usr/local/libexec/honeypot-ghosts/network-filter.sh teardown

[Install]
WantedBy=multi-user.target
