node_modules/
.output/
.nitro/
.tanstack/
dist/
.env
target/

# Python bytecode. Tracked copies got swept in by a `git add -A` after a
# local pytest run (#1742 work) and had to be deleted again -- ignore them so
# that cannot recur.
__pycache__/
*.py[cod]

# Playwright MCP writes accessibility snapshots and screenshots into the
# directory a browser session was driven from; they are session scratch, not
# source, and one already reached main inside a backend-service commit.
.playwright-mcp/

# CI's JUnit XML and retained test logs (#3319). Written by the quality
# workflow's artifact steps and uploaded, never committed -- same reasoning
# as the Playwright run artifacts already ignored inside frontend-next.
.ci-artifacts/

# Filled-in installer answer files. These carry real WireGuard private keys,
# SSH key paths, backup-host addresses and the deployment's real public domain
# -- scripts/check-public-leaks.py fails on exactly that content, which is the
# point. Both .conf.example templates are tracked; the filled-in copies must
# never be. Untracked-but-not-ignored was one `git add .` away from putting
# them in a public repository.
conf-local/
install-homeserver.conf
install-vps.conf

# Rev·Deck upstream build context, cloned by install-homeserver.sh
# (step_revdeck_source). Upstream source, deliberately not vendored here.
analysis/ghidra/revdeck/

.grit
.orchestrator/

# External BETH benchmark data. The harness never downloads or writes it.
ml-worker/benchmarks/data/
ml-worker/benchmarks/beth-data/
round7/
1947full/

# schemathesis's local run cache (case corpus, crash dumps). The weekly job
# writes its reports to $RUNNER_TEMP instead, so this only appears when a
# developer runs `schemathesis run` against the crate by hand -- and it is
# per-machine derived data, not something to review.
.schemathesis/

# The committed http-honeypot binary (#3463). The image builds its own from
# *.go in the builder stage and never copies this blob, so nothing reads it --
# but any in-tree `go build` silently rewrote the tracked file, which left a
# phantom diff in unrelated work and was one `git add -A` away from committing
# a machine-local artifact. Same failure mode as the Python bytecode above.
arcane/home/honeypot-http/http-honeypot/http-honeypot

# archify's working folder (#3497): the typed candidate, the rendered HTML and
# its gate receipts. Intermediate -- the shipped artifact is docs/diagrams/.
.archify/

# graphify knowledge-graph output (#3497). `graphify update .` writes ~890 MB
# here: a 282 MB graph.json, a 311 MB AST cache, and a per-run-date copy of
# both. All of it is regenerable from the tree and nothing in the repo reads
# it, so only the two reader-facing artifacts are tracked -- the explorer
# (graph.html) and the dated report (YYYY-MM-DD/GRAPH_REPORT.md), both indexed
# from docs/architecture/graph-report.md. Ignoring the rest is the same
# failure mode as .ci-artifacts/ and .playwright-mcp/ above: generated output
# that a `git add -A` would otherwise put in a public repository.
graphify-out/cache/
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_root
graphify-out/.graph.html.stale
graphify-out/20??-??-??/*
!graphify-out/20??-??-??/graph.html
!graphify-out/20??-??-??/GRAPH_REPORT.md

# Ad-hoc coder worktrees that get created in the repository root during
# dispatch (oc-<issue>-wt/). They are
# untracked scratch, but they sit inside the tree graphify indexes, so every
# artifact they produce counts them as real files: a published report listed a
# script under one of them that #3310 had already deleted from the mainline
# tree, so test_3310_design_lab_dedupe.py failed on a path that no longer
# exists. graphify honours .gitignore by default, so this one rule fixes the
# artifact by construction rather than by editing the report or by teaching the
# test to skip generated output. Remove a directory only when the dispatch it
# belongs to is finished; these are live worktrees for open issues.
oc-*-wt/
