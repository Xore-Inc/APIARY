# Safe defaults. The base Compose stack has no route to Elasticsearch,
# Ollama, or captured payloads and runs only synthetic contract checks.
LLM_ENABLED=false
LLM_DRY_RUN=true
LLM_ALLOW_CAPTURED_DATA=false
LLM_SESSION_ENABLED=false
LLM_PAYLOAD_ENABLED=false
LLM_DAILY_REPORT_ENABLED=false

LLM_MODEL=qwen3:14b
LLM_EXPECTED_MODEL_DIGEST=
LLM_CONTEXT_LENGTH=8192
LLM_OUTPUT_TOKENS=512
LLM_KEEP_ALIVE=10m
POLL_INTERVAL=60
MAX_CONTENT_CHARS=12000
MAX_PAYLOAD_BYTES=1048576
MAX_EVENTS_PER_CYCLE=2000
MAX_JOBS_PER_CYCLE=20
MAX_PAYLOAD_SCAN_FILES=5000
MAX_PAYLOAD_SCAN_BYTES=67108864
SESSION_IDLE_SECONDS=300
SESSION_LOOKBACK_SECONDS=3600
DAILY_REPORT_HOUR=6
LOG_LEVEL=INFO

# optional (#3576): comma-separated extra hosts accepted in OLLAMA_URL beyond
# `ollama`, localhost and private addresses -- e.g. an overlay service name or
# a remote HTTPS host. Must match the backend's OLLAMA_ALLOWED_HOSTS.
# OLLAMA_URL itself is set in the captured-data/canary compose overrides.
OLLAMA_ALLOWED_HOSTS=
