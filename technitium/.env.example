# technitium — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# REQUIRED: the homeserver's LAN IP address (same mechanism the old pihole
# stack used since #1502 — see this compose.yml's own header). DNS (53), the
# admin console (5380) and cluster replication (53443, reached by the
# primary on hermes) all bind here. LAN exposure is deliberate (#3604,
# 2026-10-18): LAN clients resolve through this node and the primary
# replicates over the LAN.
LAN_IP=

# REQUIRED: Technitium admin console password (bootstrap only — after first
# boot it lives in ./config and this value is ignored by the server).
TECHNITIUM_PASSWORD=

# optional: the DNS domain this server is authoritative for on the LAN
DNS_SERVER_DOMAIN=homeserver.lan

# optional, defaults to 'Europe/Berlin' if unset
INSTALL_TIMEZONE=Europe/Berlin
