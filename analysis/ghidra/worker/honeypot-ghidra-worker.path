[Unit]
Description=Watch for honeypot Ghidra analysis requests
Documentation=file:/opt/honeypot-ghidra/DASHBOARD_INTEGRATION_PLAN.md
# No After=docker.service here (#3742): a .path unit is ordered Before=paths.target,
# which basic.target needs, and docker.service starts after basic.target (via
# firewalld). The ordering made a boot cycle; on 2026-11-13 systemd broke it by
# dropping firewalld's start. The triggered service keeps After=docker.service.

[Path]
# The dashboard writes {sha256}.request here; it never calls the Ghidra REST
# service itself. Same trust boundary as the sandbox spools.
PathChanged=/var/lib/honeypot-ghidra/requests/pending
# Standalone Rev·Deck spool (#78) -- a second, independent request directory
# the same service also drains (drain_revdeck() in ghidra-worker.py). One
# .path/.service pair watching two directories, rather than a second unit
# pair, since both drains already run from the same script invocation.
PathChanged=/var/lib/honeypot-revdeck/requests/pending
Unit=honeypot-ghidra-worker.service

[Install]
WantedBy=multi-user.target
