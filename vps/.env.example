# Copy to .env in this vps/ directory and fill in the values.
# docker-compose will automatically load .env from the same directory.
#
# Keycloak issuer and gateway secrets stay host-local. Each protected service
# has its own client-secret and raw 32-byte cookie-secret files beneath the
# directory below; never reuse either file between gateways. Directories are
# root:65532 mode 0750 and files are root:65532 mode 0440 so oauth2-proxy's
# non-root process can read them without making them world-readable.
OIDC_ISSUER_URL=https://auth.honeypot.example/realms/apiary
OIDC_PUBLIC_DOMAIN=honeypot.example
OIDC_SECRETS_DIR=./secrets/oidc

# Dashboard bridge destinations. The legacy bridge stays available for
# rollback; the candidate bridge can point to a different WireGuard host.
# These defaults match the current homeserver deployment. Change only the
# candidate pair for staging, then set the legacy pair to the rollback target.
DASHBOARD_LEGACY_HOST=10.8.0.2
DASHBOARD_LEGACY_PORT=19090
DASHBOARD_CANDIDATE_HOST=10.8.0.2
DASHBOARD_CANDIDATE_PORT=19092

# #261: same single retention knob as the home stack's .env.example --
# suricata-log-maintenance.sh and portbridge-log-maintenance.sh both scale
# their on-disk JSON pruning window from this by default.
#
# #2820 deliberately did NOT lower this to 21 alongside the home stack, and
# the two are expected to differ. #2820 was a homeserver capacity incident:
# Elasticsearch at 1000/1000 shards and /var at 94%. The VPS has neither
# problem -- measured 2026-09-02, / is 116 G with 76 G free (35% used), and
# it runs no Elasticsearch. Inheriting 21 here would buy nothing and would
# cut on-disk forensic retention on the internet-facing host by 30%
# (suricata/portbridge log-maintenance pruning at 3024 min instead of
# 4320). Change this only for a VPS-side reason, measured on the VPS.
HONEYPOT_RETENTION_DAYS=30

# ── Suricata IDS ─────────────────────────────────────────────────────
# The NIC Suricata, Zeek and huginn-sidecar sniff.
#
# Leave this alone: detect-capture-interface.service rewrites it at every
# boot from whichever interface carries the default route, because the name
# is the provider's and the kernel's to choose, not ours to predict. It was
# ens6 on this VPS until a reboot brought it back as eth0, at which point
# Zeek and huginn died and Suricata kept running against an interface that
# no longer existed (#1929).
#
# Set it by hand only to capture on an interface that is *not* the default
# route's -- and then disable the unit, or the next boot will overwrite it.
CAPTURE_INTERFACE=eth0

# HOME_NET must be the VPS public IP in CIDR notation — never "any".
# Rules using !$HOME_NET with HOME_NET=any produce a NIL address range
# and cause a fatal parse error at startup.
#
# Get your VPS public IP: curl -s ifconfig.me
# Then set it here as a /32:
SURICATA_HOME_NET=YOUR.VPS.IP.HERE/32

# EXTERNAL_NET should be the inverse of HOME_NET.
# If you have multiple IPs or also want to include the WireGuard range:
#   SURICATA_HOME_NET=[203.0.113.10/32,10.8.0.0/24]
SURICATA_EXTERNAL_NET=!$SURICATA_HOME_NET

# ── Dashboard service token (manual IP-block export sidecar) ───────────
#
# #3403: the `blackhole` profile's portbridge-manual-blackhole-refresh sidecar
# pulls the operator-blocked list from the homeserver every 5 minutes, over the
# WireGuard tunnel, and writes it to /blackhole/manual.txt. It is only
# reachable at /api/v1/ip-block-export, which is auth-gated like every other
# /api/v1 route (#2183) -- an unauthenticated request gets a 307 to
# /auth/login, not the list. This is the shared secret that request presents.
#
# It is the SAME value as the homeserver's DASHBOARD_SERVICE_TOKEN
# (honeypot-dashboard/.env, which its own compose.yml maps to SERVICE_TOKEN for
# every tier). Same name on purpose: there is one service token in this fleet,
# not one per consumer. There is deliberately no second mechanism for the VPS
# to authenticate with.
#
# Leave it empty and the sidecar says so, loudly and every 5 minutes, and keeps
# whatever list it already has -- it does NOT fall back to an unauthenticated
# request, because that answers 307 and is the bug #3403 was about.
#
# This file is chmod 600 on the VPS (install-vps.sh) and is excluded from the
# deploy rsync, so the value never enters the repository. Never paste a real
# token into a committed file, a log, or a pull request.
DASHBOARD_SERVICE_TOKEN=
