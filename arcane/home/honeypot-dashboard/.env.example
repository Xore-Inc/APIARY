# honeypot-dashboard — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '10' if unset
AGENT_INTRUSION_FETCH_WINDOW_DAYS=10

# optional, defaults to '10000' if unset
AGENT_INTRUSION_MAX_EVENTS_PER_SOURCE=10000

# optional, defaults to '300' if unset
AGENT_INTRUSION_POLL_INTERVAL=300

# Optional for backend-service-mounted only. Sensor-bound workers continue
# using their local Elasticsearch name. Set a remote address only after the
# private authenticated transport from #3577 is available.
BACKEND_MOUNTED_ELASTICSEARCH_URL=http://elasticsearch:9200

# optional, defaults to '' if unset
ARKIME_PUBLIC_URL=

# optional, defaults to '15m' if unset
ATTACKER_IDENTITY_RUN_INTERVAL=15m

# optional, defaults to 'https://auth.example.invalid/realms/apiary/account/' if unset
AUTH_ACCOUNT_URL=https://auth.example.invalid/realms/apiary/account/

# optional, defaults to 'https://auth.example.invalid/admin/apiary/console/' if unset
AUTH_ADMIN_URL=https://auth.example.invalid/admin/apiary/console/

# optional, defaults to '' if unset — #1608 cross-host split: the frontend
# tier's route to the BFF tier when SERVE_MODE=frontend splits them onto
# different docker hosts. Unused (loopback, same process) while
# DASHBOARD_SERVE_MODE stays at its 'all' default.
BFF_INTERNAL_URL=

# CANARYTOKENS_API_URL, HONEYFS_IMPLANT_URL and HONEYFS_IMPLANT_TOKEN used
# to be listed in this file. They are not set here: this stack's compose
# interpolates none of them, so a value put here is read by nothing.
#
# They belong to honeypot-dashboard-backend, which is where the credential
# and canarytoken APIs are served from. Setting HONEYFS_IMPLANT_URL here
# instead is exactly what happened, and the result was that every credential
# implant returned 503 "not configured" while the value sat in this file
# looking correct (#1487).
#
#2425: HONEYPOT_MAP_TILE_URL and HONEYPOT_MAP_ATTRIBUTION are gone too --
# they fed the retired Go dashboard's server-side template; frontend-next's
# Leaflet layer hardcodes the OSM tile URL and attribution outright
# (OverviewPanels.tsx), and the settings schema enum-locks
# behavior.map_provider to a single value ("osm"), so neither knob has a
# reader to reach anymore.

# optional, defaults to '' if unset
CAPE_REQUEST_DIR=

# optional, defaults to '' if unset
CAPE_RESULTS_DIR=

# optional, defaults to '168h' if unset
CORRELATION_WINDOW=168h

# optional, defaults to '15m' if unset
CORRELATOR_RUN_INTERVAL=15m

# optional, defaults to '' if unset — #1616 scaling: the shared undici
# keep-alive pool's max sockets to the Rust tier.
DASHBOARD_BACKEND_HTTP_MAX_SOCKETS=

# optional, defaults to '' if unset — #1616 scaling: max concurrent
# requests the BFF admits to the Rust tier before queuing.
DASHBOARD_BACKEND_MAX_INFLIGHT=

# optional, defaults to '' if unset — #1616 scaling: how many more
# requests queue behind DASHBOARD_BACKEND_MAX_INFLIGHT before the BFF
# sheds load with 503 instead of growing the queue further.
DASHBOARD_BACKEND_MAX_QUEUE=

# optional, defaults to OIDC_EXTERNAL_URL if unset — #1628 staged/beta
# path: dashboard-next's own OIDC redirect host, separate from
# OIDC_EXTERNAL_URL (which production's `dashboard` also reads) since
# Keycloak only accepts an exact-match registered redirect_uri per host.
# Leave unset until dashboard-next is ever meant to be reachable at a
# different host than production (e.g. beta.honeypot.<domain>) — setting
# it requires registering that host's /auth/callback on the Keycloak
# apiary-dashboard client first (see docs/KEYCLOAK-CUTOVER.md).
DASHBOARD_NEXT_OIDC_EXTERNAL_URL=

# optional, defaults to 'true' if unset
DASHBOARD_REQUIRE_ADMIN=true

# optional, defaults to '/var/dockge/stacks/honeypot-dashboard/secrets' if unset
DASHBOARD_SECRETS_DIR=/var/dockge/stacks/honeypot-dashboard/secrets

# optional, defaults to 'all' if unset — #1608 cross-host split: 'all'
# (frontend+BFF combined, the only mode actually deployed today),
# 'frontend', or 'bff'. See BFF_INTERNAL_URL above.
DASHBOARD_SERVE_MODE=all

# optional, defaults to '' (disabled) if unset — the shared secret
# dashboard-next and backend-service authenticate each other with
# (SERVICE_TOKEN in backend-service's own environment, same value). Empty
# refuses to boot (#2183): both tiers fail at startup with [E-SERVICE-TOKEN]
# instead of silently serving unauthenticated. Set it to a real value before
# any real deployment — both tiers share the honeynet bridge with every
# honeypot sensor container. Set the identical value here and in
# honeypot-dashboard-backend's own env.
DASHBOARD_SERVICE_TOKEN=

# optional, defaults to '' (refusal, see above) if unset — the ONE
# dev-only escape hatch from #2183: set to exactly 1 to boot both tiers
# without a token (local dev only; each container logs a loud
# [E-SERVICE-TOKEN] line while it runs). Any other value is still a
# refusal. Real deployments leave this unset.
APIARY_ALLOW_UNAUTH_DEV=

# optional, defaults to '' if unset — #1616 scaling: cluster.mjs's worker
# count, default min(4, host cpus) when unset.
DASHBOARD_WEB_CONCURRENCY=

# optional, defaults to '300' if unset
ES_IMPORTER_INTERVAL=300

# optional, defaults to '1' if unset
ES_IMPORTER_SHARD_COUNT=1

# optional, defaults to '' if unset
EVEBOX_PUBLIC_URL=

# optional, defaults to '6h' if unset
EVIDENCE_WINDOW=6h

# optional, defaults to 'http://filebeat:5066' if unset
FILEBEAT_URL=http://filebeat:5066

# optional, defaults to 'false' if unset
GHIDRA_ALERT_ON_CRYPTO=false

# optional, defaults to 'high,critical' if unset
GHIDRA_ALERT_RISK_LEVELS=high,critical

# optional, defaults to '' if unset
GHIDRA_REQUEST_DIR=

# optional, defaults to '' if unset
GHIDRA_RESULTS_DIR=

# optional, defaults to '' if unset
GHOSTS_SANDBOX_REQUEST_DIR=

# optional, defaults to '' if unset
GHOSTS_SANDBOX_RESULTS_DIR=

# optional, defaults to '10' if unset
GITHUB_ANALYSIS_ALERT_POSITIVES=10

# optional, defaults to '' if unset
GITHUB_ANALYSIS_REQUEST_DIR=

# optional, defaults to '' if unset
GITHUB_ANALYSIS_RESULTS_DIR=

# optional, defaults to '80' if unset
HONEYPOT_ALERT_CAMPAIGN_SCORE=80

# optional, defaults to '6h' if unset
HONEYPOT_ALERT_COOLDOWN=6h

# optional, defaults to '10' if unset
HONEYPOT_ALERT_INGEST_FLOOR_PERCENT=10

# optional, defaults to '1000' if unset
HONEYPOT_ALERT_INGEST_MIN_BASELINE=1000

# optional, defaults to '' if unset
HONEYPOT_ALERT_WEBHOOK_URL=

# optional, defaults to '' if unset
HONEYPOT_DOMAIN=

# optional, defaults to '' if unset
HONEYPOT_SELF_IPS=

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

# optional, defaults to '67108864' if unset
JSON_STREAM_MAX_BYTES=67108864

# optional, defaults to '' if unset
KIBANA_PUBLIC_URL=

# optional, defaults to 'high,critical' if unset
LLM_ANALYSIS_ALERT_SEVERITIES=high,critical

# optional, defaults to '90' if unset
LOG_STREAM_ALERT_PERCENT=90

# optional, defaults to 'https://honeypot.example.invalid' if unset
OIDC_EXTERNAL_URL=https://honeypot.example.invalid

# optional, defaults to 'https://auth.example.invalid/realms/apiary' if unset
OIDC_ISSUER_URL=https://auth.example.invalid/realms/apiary

# optional, defaults to '5m' if unset -- scan cadence handed to the
# payload-inventory loop's own SCAN_INTERVAL (#1982)
PAYLOAD_INVENTORY_SCAN_INTERVAL=5m

# optional, defaults to '' if unset
REVDECK_REQUEST_DIR=

# optional, defaults to '' if unset
REVDECK_RESULTS_DIR=

# optional, defaults to '50' if unset
SANDBOX_ALERT_RISK_SCORE=50

# optional, defaults to '' if unset
SANDBOX_VNC_BRIDGE_WS=

# optional, defaults to '' if unset
WINDOWS_SANDBOX_REQUEST_DIR=

# optional, defaults to '' if unset
WINDOWS_SANDBOX_RESULTS_DIR=

# optional, defaults to '60' if unset (seconds between workbench reconcile
# passes; the effective workbench loop cadence)
WORKBENCH_RECONCILE_INTERVAL_SECONDS=60

# optional, defaults to '120' if unset (seconds between zeek-proxy
# attribution passes on this tier)
ZEEK_PROXY_ATTRIBUTION_INTERVAL_SECONDS=120

# optional, defaults to '300' if unset (seconds between dashboard-rollup
# passes on this tier; the rollups worker writes the derived overview/
# map/kill-chain indices, #2046/#1982)
ROLLUP_RUN_INTERVAL_SECS=300

# optional, defaults to '/logs/dashboard-backend-mounted/app.jsonl' if
# unset — #1972: the mounted backend-service instance appends one JSONL
# line per served request here, onto the filebeat-tailed logs root, so an
# API incident survives the container json-file rotation. Set it empty to
# switch the writer off; the dir itself is provisioned/chowned by
# honeypot-init's log-init step.
DASHBOARD_LOG_FILE=/logs/dashboard-backend-mounted/app.jsonl

# optional, defaults to '/logs/dashboard-bff/app.jsonl' if unset — #1972's
# BFF counterpart: named outcomes only (auth sign-in started/failed/
# completed and other recordNamedEvent call sites), not one line per
# request. Usernames deliberately never appear among the fields. Empty
# disables.
DASHBOARD_BFF_LOG_FILE=/logs/dashboard-bff/app.jsonl

# GID of the deploy-runner group ON THIS HOST. Two services in this stack join
# it via group_add so their unprivileged users can read files that group owns:
# dashboard-next (runs as `node`, reads secrets/oidc-client-secret) and
# backend-worker-enrichment (runs as `nobody`, writes logs/enriched and
# state/ip-enrichment-worker).
#
# It must be numeric: group_add cannot take a name, because /etc/group exists on
# the host and not inside these images. That makes it a property of how the host
# was built rather than a constant -- system GIDs are assigned in creation
# order, so a rebuild moves them. On the 2026-09-03 rebuild the previously
# hardcoded 980 and 979 had become github-ci-runner-3 and -4, both containers
# joined unrelated CI groups, sign-in failed with EACCES on the OIDC secret and
# IP enrichment silently wrote nothing while reporting healthy.
#
# install-homeserver.sh's step_pin_deploy_runner_gid writes the host's real
# value into this stack's .env. Set it by hand only for a manual stand-up:
#   getent group deploy-runner | cut -d: -f3
DEPLOY_RUNNER_GID=980

# #3315 -- the git revision apiary-dashboard-next is built from. Optional and
# empty by default; see the identical block in
# ../honeypot-dashboard-backend/.env.example for the full reasoning. Briefly:
# it lands in the image's /build.json and its
# org.opencontainers.image.revision label, and
# scripts/verify-deploy.sh reports a missing one as an unstamped deploy
# instead of passing silently.
#
# The two dashboard stacks carry the variable independently: a build of one
# says nothing about the other, so set it in both .env files.
#   echo "GIT_SHA=$(git rev-parse HEAD)" >> .env
GIT_SHA=
