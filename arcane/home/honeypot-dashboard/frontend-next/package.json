{
  "name": "frontend-next",
  "private": true,
  "type": "module",
  "engines": {
    "npm": "10"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:discovery": "node scripts/test-discovery-guard.mjs",
    "coverage:ratchet": "node scripts/coverage-ratchet.mjs",
    "coverage:baseline": "node scripts/coverage-ratchet.mjs --update",
    "test:browser": "playwright test",
    "test:property": "vitest run src/lib/appearanceCookie.property.test.ts",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "^3.34.4",
    "echarts": "^6.1.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "nitro": "3.0.260610-beta",
    "openid-client": "^6.8.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tanstack/router-cli": "1.167.46",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "lru-cache": "^11.2.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
