# honeypot-galah — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

# optional, defaults to 4. Max requests the galah LLM broker forwards to
# Ollama at once; the next gets an immediate 503. 0 disables the cap (#3666).
GALAH_BROKER_MAX_INFLIGHT=4
