# Dockge stack: honeypot-keycloak
HP_BIND=10.8.0.2
KEYCLOAK_PORT=18080
KEYCLOAK_URL=https://auth.honeypot.example
KEYCLOAK_PUBLIC_DOMAIN=honeypot.example
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
# #3824: id of the temporary bootstrap admin *client* Keycloak creates on an
# empty database while secrets/bootstrap-admin-client-secret exists
# (provision-admin-client.sh replaces it with the permanent apiary-ops-admin).
KEYCLOAK_BOOTSTRAP_ADMIN_CLIENT_ID=bootstrap-admin-client
KEYCLOAK_THEME_DIR=/var/dockge/stacks/honeypot-keycloak/theme/apiary
KEYCLOAK_SECRETS_DIR=/var/dockge/stacks/honeypot-keycloak/secrets

RESTIC_REPOSITORY=/mnt-2/apiary-keycloak
RESTIC_PASSWORD_FILE=/var/dockge/stacks/honeypot-keycloak/secrets/restic-password
RESTIC_HOST=apiary-homeserver
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
RESTIC_CHECK_SUBSET=5%
