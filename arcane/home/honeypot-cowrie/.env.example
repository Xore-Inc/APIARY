# honeypot-cowrie — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to 'false' if unset
COWRIE_AIR_GAPPED=false

# optional, defaults to '' (no bearer check) if unset -- defense-in-depth
# token for the honeyfs-implant API, layered under the WireGuard-only
# network boundary; empty matches every other internal-only API here
HONEYFS_IMPLANT_TOKEN=

# optional, defaults to '' if unset (#3690) -- alternative to
# HONEYFS_IMPLANT_TOKEN: a path INSIDE the honeyfs-implant container to a
# file holding the token (read once at startup, trailing newline trimmed).
# The file must be mounted into the container to be useful. Setting both, or
# naming an unreadable or empty file, makes the service exit non-zero with
# [E-IMPLANT-TOKEN] rather than run without auth.
HONEYFS_IMPLANT_TOKEN_FILE=

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2
