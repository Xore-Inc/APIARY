# honeypot-dashboard-backend — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '' if unset -- dev-only escape hatch that lets both
# tiers serve without DASHBOARD_SERVICE_TOKEN. Never set on a real
# deployment. The fuller write-up lives in honeypot-dashboard's own
# .env.example; this stack's compose interpolates its own copy (#1982), so
# it is documented here too rather than only by reference.
APIARY_ALLOW_UNAUTH_DEV=

# Optional for the HTTP backend API. The current homeserver uses the local
# honeynet DNS name. A PRECISION deployment must use #3577's private,
# authenticated transport; raw Elasticsearch HTTP must stay unexposed.
ELASTICSEARCH_URL=http://elasticsearch:9200

# optional, defaults to 'http://filebeat:5066' if unset
FILEBEAT_URL=http://filebeat:5066

# optional, defaults to '' if unset
# This fleet's own addresses, comma-separated -- the exclusion list keeping
# honeypot/self traffic out of attacker-facing views. The complete prose
# version lives in honeypot-dashboard's .env.example under the same key;
# listed here because this stack's compose interpolates its own copy for
# the backend tier (#1982).
HONEYPOT_SELF_IPS=

# IPv4 addresses seen in sensor records, regardless of which host serves the
# HTTP API. The defaults match this fleet's VPS relay and homeserver sensor.
# Keep the same pair across the API and sensor-bound worker deployments.
HONEYPOT_TUNNEL_PEER_IP=10.8.0.1
HONEYPOT_TUNNEL_SENSOR_IP=10.8.0.2

# optional, defaults to '' if unset
# The self-hosted Canarytokens platform's frontend, published on the
# WireGuard address only by honeypot-canarytokens' compose --
# http://10.8.0.2:19426 on this fleet. Same reachability posture as
# HONEYFS_IMPLANT_URL below.
#
# Leaving it empty is not neutral: canarytokens::create answers 503
# "canarytoken creation is not configured on this host", and every other
# part of the feature -- the platform, the adapter, the store, the page --
# keeps working, so the dashboard looks healthy while token creation is
# switched off. That is exactly how it shipped (#1487); the platform had
# been up and healthy the whole time.
CANARYTOKENS_API_URL=

# URL baked into newly minted token triggers. The current homeserver adapter
# uses this address; set a reachable private endpoint for another host.
CANARYTOKENS_ADAPTER_WEBHOOK_URL=http://canarytokens-adapter.internal:8090/

# optional, defaults to '' (refusal) if unset — the shared secret this
# service and dashboard-next (in the sibling honeypot-dashboard stack)
# authenticate each other with. Empty refuses to boot (#2183): both tiers
# fail at startup with [E-SERVICE-TOKEN] instead of silently serving
# unauthenticated. Both tiers share the honeynet bridge with every honeypot
# sensor container, so this should be set to a real value before any real
# deployment, not left at the default. Set the identical value here and as
# DASHBOARD_SERVICE_TOKEN in honeypot-dashboard's own env. The dev-only
# escape hatch is APIARY_ALLOW_UNAUTH_DEV=1 (see that stack's .env.example).
DASHBOARD_SERVICE_TOKEN=

# optional, defaults to '' if unset
HONEYFS_IMPLANT_TOKEN=

# optional, defaults to '' if unset
# The honeyfs-implant service, published on the WireGuard address only by
# honeypot-cowrie's compose -- http://10.8.0.2:19428 on this fleet. This
# stack is the one that reads it: the credential API lives here, and with
# this unset every implant returns 503 "not configured" (#1487).
HONEYFS_IMPLANT_URL=

# optional, defaults to '5m' if unset
PAYLOAD_INVENTORY_SCAN_INTERVAL=5m

# optional, defaults to '/logs/dashboard-backend/app.jsonl' if unset —
# #1972: backend-service appends one JSONL line per served request here,
# onto the filebeat-tailed logs root (dashboard-backend-v1-* in ES), so an
# incident reconstructs from Elasticsearch after the redeploy rotated the
# container ring buffer away. Empty disables the writer; honeypot-init's
# log-init step provisions and chowns the directory (uid 65534).
DASHBOARD_LOG_FILE=/logs/dashboard-backend/app.jsonl

# optional, defaults to 'qwen3:14b' if unset -- the Ollama model
# /api/v1/vault-rag generates its grounded answer with (#2292). The same
# key llm-worker reads (llm-worker/.env.example), deliberately, so the
# chat/analysis model is set once for the whole fleet rather than under a
# second name only this endpoint would honour; a value here that names a
# model the card has not pulled makes the endpoint answer 503 rather than
# fall back to an unvetted one.
LLM_MODEL=qwen3:14b

# optional, defaults to '5m' if unset -- how long Ollama keeps the
# LLM_MODEL weights resident after a vault-rag request. Shorter than the
# shared OLLAMA_KEEP_ALIVE=30m server default on purpose: this endpoint is
# operator-invoked and occasional, and it shares a 20 GiB card with the
# ghidra, Rev·Deck and session-analysis slots, so holding the weights for
# the server default would evict a worker that runs continuously to serve
# one that does not.
LLM_KEEP_ALIVE=5m

# #3315 -- the git revision apiary-backend is built from. Optional: unset
# means the image is built with no revision, /healthz reports
# {"revision":"unknown"} and the image's org.opencontainers.image.revision
# label is "unknown", which scripts/verify-deploy.sh reports as an unstamped
# deploy rather than passing silently.
#
# Take the value from the checkout you are actually deploying -- the commit
# that was merged, not the branch name. Not from /opt/stacks/apiary, which
# looks like a clone but is a `git ls-files`/rsync of the working tree with
# .git/ excluded (see .github/workflows/deploy.yml's own sync step), so
# `git -C /opt/stacks/apiary rev-parse HEAD` there fails. From a real clone:
#   echo "GIT_SHA=$(git rev-parse HEAD)" >> .env
# For an Arcane-driven build that is the only place it has to be set: the
# synced directory has no .git, and compose will not invent one. For a manual
# `docker compose build` in the synced directory, the environment works too:
#   GIT_SHA=$(git rev-parse HEAD) docker compose build backend-service
#
# It is a revision, not a branch: the whole point is that "is the merge on the
# host?" becomes a curl of /healthz rather than an inference from image
# timestamps. Never a branch name, a tag, or a hand-typed guess -- a value that
# is not an object name is normalized to "unknown" by the binary itself.
GIT_SHA=
