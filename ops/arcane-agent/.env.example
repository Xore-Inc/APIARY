# Arcane edge agent (ops/arcane-agent/compose.yml). Copy to .env, mode 0600.

# Per-environment agent token, shown by Arcane when the environment is created
# (Environments -> <env> -> agent setup). Secret; never commit the real value.
ARCANE_AGENT_TOKEN=CHANGE_ME

# Where the agent reaches the manager API.
#   VPS:       http://10.8.0.2:3552  (homeserver over WireGuard)
#   precision: http://127.0.0.1:13552 (local end of an ssh -L forward to the
#              manager, see docs/SWARM-NETWORK.md)
ARCANE_MANAGER_API_URL=http://10.8.0.2:3552
