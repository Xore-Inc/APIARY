[Unit]
Description=Route the other manager's hub address over the healthy direct WireGuard path
Wants=network-online.target
After=network-online.target wg-quick@wg0.service wg-quick@wg-fibre.service wg-quick@wg-lan.service

[Service]
Type=simple
EnvironmentFile=/etc/apiary/swarm-peer.env
ExecStart=/usr/local/libexec/apiary-swarm-peer-route --watch $PEER_HUB $LOCAL_HUB $FIBRE_PEER $LAN_PEER
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
