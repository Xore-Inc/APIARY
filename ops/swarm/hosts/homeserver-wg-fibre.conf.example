[Interface]
Address = 10.8.1.1/30
ListenPort = 51821
MTU = 8920
Table = off
# Loose reverse-path check: the peer hub /32 moves between wg-fibre and wg-lan on failover;
# AllowedIPs already rejects spoofed sources.
PostUp = sysctl -q -w net.ipv4.conf.%i.rp_filter=2
PrivateKey = REPLACE_WITH_HOST_GENERATED_PRIVATE_KEY

[Peer]
PublicKey = REPLACE_WITH_PRECISION_FIBRE_PUBLIC_KEY
AllowedIPs = 10.8.1.2/32, 10.8.0.3/32
Endpoint = 10.254.250.2:51821
PersistentKeepalive = 15
