# swarm-plane.sh settings for the VPS. Sourced as shell.
# Swarm manager since 2026-10-19 (#3587, #3712): the third raft member, on the
# hub address only. Its node label stays role=worker, so role==manager
# placements skip it.
# Flow reasons live in swarm-plane.sh and docs/SWARM-NETWORK.md (flow matrix).

SWARM_ZONE=apiary-swarm
# TCP 2377 (raft and manager API) from the two peers on wg0 only. Setting 0
# here and applying would drop 2377 and cut the VPS out of raft.
SWARM_MANAGER=1

# Only the hub tunnel. eth0 is public and must never carry the swarm plane.
SWARM_IFACES="wg0"

# homeserver and precision hub addresses.
SWARM_PEERS="10.8.0.2/32 10.8.0.3/32"

# sshd listens on 2222 (port 22 is the portbridge/cowrie honeypot). homeserver
# opens SSH to 10.8.0.1:2222 over wg0, so keep it peer-scoped here.
SWARM_SSH_PORT=2222

LAN_ZONES="public"

# The hub listener 51820/udp is already open in the VPS public zone
# (WireGuard endpoint, public by design); nothing extra here.
