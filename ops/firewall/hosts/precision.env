# swarm-plane.sh settings for precision. Sourced as shell.
# Flow reasons live in swarm-plane.sh and docs/SWARM-NETWORK.md (flow matrix).

SWARM_ZONE=apiary-swarm
SWARM_MANAGER=1

# ens1f1 is the direct fibre to homeserver (underlay of wg-fibre). The 10 Gb
# uplink ens1f0 is LAN and must stay out of this zone. Names checked live on
# 2026-10-31 (#3712): udev names the NetXen card by slot (ens1f0/ens1f1, PCI
# b3:00.0/.1). The repo said enp4s0f0/enp4s0f1 until then.
SWARM_IFACES="ens1f1 wg0 wg-fibre wg-lan"

# Phase 0: homeserver's fibre address.
SWARM_PEERS="10.254.250.1/32 10.8.0.1/32 10.8.0.2/32 10.8.1.1/32 10.8.2.1/32"
WG_FIBRE_PEER=10.254.250.1/32
WG_LAN_PEER=REPLACE_WITH_HOMESERVER_LAN_IP/32

LAN_ZONES="public"
