# swarm-plane.sh settings for homeserver (supermicro). Sourced as shell.
# Flow reasons live in swarm-plane.sh and docs/SWARM-NETWORK.md (flow matrix).

# Zone that carries the swarm plane. Default deny, logged.
SWARM_ZONE=apiary-swarm
SWARM_MANAGER=1

# Interfaces bound into SWARM_ZONE. Never a LAN or public interface.
# The hub tunnel also carries current sensors and gateways. Docker-published
# ports traverse FORWARD, so the separate DOCKER-USER policy must be applied.
SWARM_IFACES="ens9f1 wg0 wg-fibre wg-lan"

# Sources allowed to speak the swarm plane (and peer-scoped SSH).
SWARM_PEERS="10.254.250.2/32 10.8.0.1/32 10.8.0.3/32 10.8.1.2/32 10.8.2.2/32"
WG_FIBRE_PEER=10.254.250.2/32
WG_LAN_PEER=192.168.42.247/32

# Not managed here: `rule family=ipv4 source 10.8.0.0/24 port 3552/tcp accept`
# (hand-added for Arcane). Arcane is a Docker-published port (10.8.0.2:3552), so
# hub traffic to it is DNATed and filtered in DOCKER-USER by home-wg-forward
# (homeserver-wg-ports.txt), not by this INPUT zone. apply keeps the rule and
# status lists it as unmanaged (#3712).

# Zones of LAN/public interfaces. They get logged drops for the swarm plane.
LAN_ZONES="public"
